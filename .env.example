# Server Configuration
PORT=3000
BIND_HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
# Max file size in bytes (default: 100MB)

# Auto-update artifacts (electron-updater generic provider)
UPDATES_DIR=./updates
MAX_UPDATE_FILE_SIZE=524288000
# Max update file size in bytes (default: 500MB)

# GitHub release sync (optional)
GITHUB_UPDATES_OWNER=papalqi
GITHUB_UPDATES_REPO=utility-tool
# Optional: required for private repos / higher rate limits
GITHUB_UPDATES_TOKEN=

# GitHub Webhook (recommended for automation)
# Used to validate X-Hub-Signature-256 on /api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# IMPORTANT: Change this password after first login!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# CORS Configuration
CORS_ORIGIN=*
# For production, set specific origins: http://localhost:5173,http://your-domain.com
