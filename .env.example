# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
# Max file size in bytes (default: 100MB)

# Storage Type: 'local', 'qiniu', or 'hybrid'
# - local: 仅本地存储
# - qiniu: 直接上传到七牛云
# - hybrid: 本地存储 + 大文件自动备份到七牛云（推荐）
STORAGE_TYPE=local

# Backup Threshold (仅 hybrid 模式需要)
# 文件大于此大小时将自动备份到七牛云 (bytes)
# 默认: 10485760 (10MB)
BACKUP_THRESHOLD=10485760

# Qiniu Cloud Storage (七牛云对象存储)
# 当 STORAGE_TYPE=qiniu 或 hybrid 时需要配置以下选项
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=http://your-cdn-domain.com
# Zone options: Zone_z0(华东), Zone_z1(华北), Zone_z2(华南), Zone_na0(北美), Zone_as0(东南亚)
QINIU_ZONE=Zone_z2

# Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# IMPORTANT: Change this password after first login!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# CORS Configuration
CORS_ORIGIN=*
# For production, set specific origins: http://localhost:5173,http://your-domain.com
